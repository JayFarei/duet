{
  "name": "duet-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "build": "pnpm --filter duet-ui build",
    "dev": "pnpm --filter duet-ui build && pnpm --parallel --filter \"./apps/*\" --filter \"./examples/*\" dev",
    "test": "pnpm --filter duet-ui test",
    "test:e2e": "pnpm --filter duet-ui build && playwright test",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.quality.json",
    "test:components": "vitest run",
    "test:distribution": "node scripts/check-distribution.mjs",
    "test:quality": "pnpm test && pnpm test:components && pnpm test:distribution && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
