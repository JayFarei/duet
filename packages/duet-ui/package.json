{
  "name": "duet-ui",
  "version": "0.4.0",
  "description": "Native-feeling controls for React web apps on the foldable iPhone: the side strip, Safari's column, split view and Home Screen apps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "default": "./dist/geometry.js"
    },
    "./styles.css": "./dist/duet.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "prepack": "pnpm build && node scripts/pack-docs.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "react",
    "nextjs",
    "iphone",
    "foldable",
    "ios",
    "safari",
    "pwa",
    "liquid-glass",
    "tab-bar",
    "navigation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayFarei/duet.git",
    "directory": "packages/duet-ui"
  },
  "homepage": "https://github.com/JayFarei/duet#readme",
  "bugs": "https://github.com/JayFarei/duet/issues",
  "author": "JayFarei"
}
